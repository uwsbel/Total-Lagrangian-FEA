module(
    name = "new_ancf",
    version = "0.1",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_cuda", version = "0.2.5")
bazel_dep(name = "rules_foreign_cc", version = "0.13.0")
bazel_dep(name = "eigen", version = "3.4.0.bcr.3")
bazel_dep(name = "googletest", version = "1.17.0")

# Bring the CMake-based DEM-Engine submodule into Bazel without adding BUILD files
# inside the submodule itself.
new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "dem_engine",
    build_file = "//third_party:dem_engine.BUILD.bazel",
    path = "third_party/DEM-Engine",
)

# Register CUDA toolchains provided by rules_cuda
register_toolchains("@rules_cuda//cuda:all")

# Compilation database for IDE support
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "1e08f8e0507b6b6b1f4416a9a22cf5c28beaba93",
)
