diff --git a/cuda/private/templates/BUILD.local_cuda_shared b/cuda/private/templates/BUILD.local_cuda_shared
index 8760094..cd7c3f0 100644
--- a/cuda/private/templates/BUILD.local_cuda_shared
+++ b/cuda/private/templates/BUILD.local_cuda_shared
@@ -1,6 +1,14 @@
 load("@bazel_skylib//rules:common_settings.bzl", "bool_setting")  # @unused
+load("@@rules_cc+//cc:defs.bzl", "cc_import", "cc_library")
 load("@rules_cuda//cuda:defs.bzl", "cc_import_versioned_sos", "if_linux", "if_windows")  # @unused
 
 package(
     default_visibility = ["//visibility:public"],
 )
+
+# Bazel 9 no longer implicitly exports source files as targets.
+# rules_cuda's generated toolchain BUILD refers to CUDA tools as file targets
+# (e.g. :cuda/bin/nvcc), so explicitly export the CUDA binary tree.
+exports_files(
+    glob(["cuda/bin/**"], allow_empty = True, exclude_directories = 1),
+)

