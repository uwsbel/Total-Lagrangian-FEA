    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/collision/capsule_28.0x14.obj"/></geometry>
    </collision>
  </link>
  <joint name="thumb_proximal_joint" type="revolute">
    <origin xyz="0 -0.035 -0.038" rpy="-2.3562 0 0"/>
    <parent link="hand_base_link"/>
    <child link="thumb_proximal"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.47" effort="1" velocity="0.5"/>
  </joint>

  <link name="thumb_intermediate">
    <inertial>
      <origin xyz="0 0.0105 0" rpy="0 0 0"/>
